{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Per-recipe cooking history",
  "type": "object",
  "required": ["id", "recipeId", "recipeVersion", "testNumber", "status", "rating", "note"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "mealSessionId": { "type": ["string", "null"] },
    "recipeId": { "type": "string", "minLength": 1 },
    "recipeVersion": { "type": "string", "minLength": 1 },
    "testNumber": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["pending", "tested", "validated", "needs_revision"] },
    "rating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "note": { "type": "string", "maxLength": 2000 },
    "createdAt": { "type": "string" }
  }
}
